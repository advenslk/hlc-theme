<!DOCTYPE html>
<html lang="en" style="background-color: #070709">
<head>
  <meta charset="utf-8">
  <title>HelzerX 3D Theme Designer · Authentication</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/x-icon" href="/extensions/nebula/editor/assets/favicon.ico">
  <link rel="stylesheet" href="../assets/base.css">
  <link rel="stylesheet" href="../assets/css/helzerx-designer.css">
  <script src="../assets/js/navigation.js"></script>
  <script src="../assets/js/editor.js"></script>
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>
  <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/animations/shift-away.css">
  <link rel="stylesheet" href="/extensions/nebula/libraries/patterns.css">
  <style>
    .match-dashboard-bg { background-color: <%= dbGet("nebula", "palette_dashboard_7") %> !important; }
    .match-auth-bg { background-color: <%= dbGet("nebula", "palette_auth_1") %> !important; }
  </style>
</head>

<body>
  <div class="container">
    <div class="navigation">
      <button onclick="navigationAction('admin')" to="admin" class="return-button" type="button"><i class="bi bi-arrow-90deg-left"></i></button>
      <div style="height: 80px;"></div>
      <button onclick="navigationAction('general')" to="general" class="navigation-button" type="button"><i class="bi bi-sliders2"></i></button>
      <button onclick="navigationAction('palette')" to="palette" class="navigation-button" type="button"><i class="bi bi-palette2"></i></button>
      <button onclick="navigationAction('sidebar')" to="sidebar" class="navigation-button" type="button"><i class="bi bi-layout-sidebar-inset"></i></button>
      <button onclick="navigationAction('dashboard')" to="dashboard" class="navigation-button" type="button"><i class="bi bi-grid-1x2"></i></button>
      <button onclick="navigationAction('authentication')" to="authentication" class="navigation-button active" type="button"><i class="bi bi-box-arrow-in-right"></i></button>
      <button onclick="navigationAction('more')" to="more" class="navigation-button" type="button"><i class="bi bi-nut"></i></button>
      <div class="save-padding"></div>
      <button onclick="saveAction()" class="save-button" type="button"><i class="bi bi-floppy-fill"></i></button>
    </div>

    <div class="editor fade">
      <%- include('../../partials/designer-toolbar') %>
      <form action="/admin/extensions/nebula" method="POST" id="editor-form" autocomplete="off">
        <div class="editor-container">
          <h2 class="editor-title">Authentication</h2>
          <p class="editor-description">Customize your sign-in screen backdrop, brand mark, and card styling.</p>

          <!-- Background -->
          <div class="option">
            <button class="modal-open" onclick="backgroundModal()" type="button" style="float: left"><i class="bi bi-plus-lg"></i></button>
            <p class="option-title with-button">Background</p>
            <input type="radio" id="background-default" name="auth_background_image" value="" class="hidden" <%= (dbGet("nebula", "auth_background_image") == "" && dbGet("nebula", "auth_background_magic") == "") ? "checked" : "" %>/>
            <label for="background-default" class="option-radio sm aspect-square"><img src="../assets/images/authentication/background/default.png" loading="lazy"/></label>
            <input type="radio" id="background-magic" name="auth_background_image" class="hidden" <%= dbGet("nebula", "auth_background_magic") != "" ? "checked" : "" %>/>
            <label for="background-magic" class="option-radio sm aspect-square" onclick="event.preventDefault();modal('#magic-modal');"><img src="../assets/images/authentication/background/magic.png" loading="lazy"/></label>
            <input type="radio" id="background-image" name="auth_background_image" class="hidden" <%= dbGet("nebula", "auth_background_image") != "" ? "checked" : "" %>/>
            <label for="background-image" class="option-radio sm aspect-square" onclick="event.preventDefault();modal('#background-modal');"><img src="../assets/images/authentication/background/image.png" loading="lazy"/></label>
            <p class="option-footer">Customize the background image or pattern of your authentication page.</p>
          </div>

          <!-- Custom logo -->
          <div class="option" id="option-customlogo">
            <p class="option-title">Custom logo</p>
            <div class="option-container with-margin">
              <span class="option-icon"><i class="bi bi-image"></i></span>
              <input type="text" id="custom-logo-field" name="auth_customlogo" class="option-input with-icon" placeholder="https://helzerx.net/logo.png" value="<%= dbGet("nebula", "auth_customlogo") %>">
            </div>
            <p class="option-footer">Add your own logo to your authentication page.</p>
          </div>

          <!-- Watermark -->
          <div class="option">
            <p class="option-title">Watermark</p>
            <input type="radio" id="watermark-on" name="watermark_auth" value="1" class="hidden" <%= dbGet("nebula", "watermark_auth") == "1" ? "checked" : "" %>>
            <label for="watermark-on" class="option-radio"><img src="../assets/images/authentication/watermark/on.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="watermark-off" name="watermark_auth" value="0" class="hidden" <%= dbGet("nebula", "watermark_auth") == "0" ? "checked" : "" %>>
            <label for="watermark-off" class="option-radio"><img src="../assets/images/authentication/watermark/off.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Show or hide the watermark on your authentication page.</p>
          </div>
        </div>

        <!-- Background modal -->
        <div class="editor-modal" id="background-modal">
          <button class="modal-close" onclick="closeModal('#background-modal')" type="button" style="float: left"><i class="bi bi-chevron-left"></i></button>
          <h2 class="editor-title with-button">Background image</h2>
          <p class="editor-description">Change your authentication page's background.</p>

          <div class="option">
            <p class="option-title">Background image</p>
            <div class="option-container with-margin">
              <span class="option-icon"><i class="bi bi-image"></i></span>
              <input type="text" id="background-image-field" name="auth_background_image" class="option-input with-icon" placeholder="https://helzerx.net/wallpaper.jpg" value="<%= dbGet("nebula", "auth_background_image") %>">
            </div>
            <p class="option-footer">Use a custom background image URL for login & registration.</p>
          </div>

          <div class="option">
            <p class="option-title">Filters</p>
            <input type="radio" id="filter-disabled" name="auth_background_appearance" value="0" class="hidden"/>
            <input type="radio" id="filter-none" name="auth_background_appearance" value="0" class="hidden" <%= dbGet("nebula", "auth_background_appearance") == "0" ? "checked" : "" %>/>
            <label for="filter-none" class="option-radio" onclick="bgDepend(event)"><img src="../assets/images/authentication/filters/none.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="filter-blur" name="auth_background_appearance" value="1" class="hidden" <%= dbGet("nebula", "auth_background_appearance") == "1" ? "checked" : "" %>/>
            <label for="filter-blur" class="option-radio" onclick="bgDepend(event)"><img src="../assets/images/authentication/filters/blur.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="filter-dim" name="auth_background_appearance" value="2" class="hidden" <%= dbGet("nebula", "auth_background_appearance") == "2" ? "checked" : "" %>/>
            <label for="filter-dim" class="option-radio" onclick="bgDepend(event)"><img src="../assets/images/authentication/filters/dim.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Change the filter of your custom background image.</p>
          </div>
        </div>

        <!-- Magic background modal -->
        <div class="editor-modal" id="magic-modal">
          <button class="modal-close" onclick="closeModal('#magic-modal')" type="button" style="float: left"><i class="bi bi-chevron-left"></i></button>
          <h2 class="editor-title with-button">Background pattern</h2>
          <p class="editor-description">Use a geometric pattern as your authentication background.</p>

          <div class="option">
            <p class="option-title">Pattern</p>
            <input type="radio" id="magic-disabled" name="auth_background_magic" value="" class="hidden" <%= dbGet("nebula", "auth_background_magic") == "" ? "checked" : "" %>/>
            <% const patterns = ['tiles','cubes','rotated-squares','l-shape','zig-zag','wavy-checkerboard','chevrons','houndstooth','quarter-circles','diagonal-rectangles','alternating-arc','rotated-rectangles','concentric-arrows','outline-triangles','moon','polka']; %>
            <% patterns.forEach(p => { %>
              <input type="radio" id="magic-<%= p %>" name="auth_background_magic" value="<%= p %>" class="hidden" <%= dbGet("nebula", "auth_background_magic") == p ? "checked" : "" %>/>
              <label for="magic-<%= p %>" onclick="magicBackground()" class="option-radio sm aspect-square pattern-label">
                <img class="pattern-preview <%= p %>" src="/extensions/nebula/libraries/assets/transparent.png" loading="lazy"/>
              </label>
            <% }); %>
            <p class="option-footer">Choose a geometric pattern.</p>
          </div>

          <div class="option">
            <p class="option-title">Size</p>
            <div class="option-container">
              <input type="range" id="pattern-size" min="50" max="500" name="auth_background_magicsize" value="<%= dbGet("nebula", "auth_background_magicsize") %>" step="5" class="option-slider">
            </div>
            <p class="option-footer">Adjust pattern scale.</p>
          </div>
        </div>

        <div id="editor-submit">
          <input type="hidden" name="_endpoint" value="/extensions/nebula/editor/edit/authentication.php">
          <input type="hidden" name="_method" value="PATCH">
          <button type="submit" class="hidden" id="submit"></button>
        </div>
      </form>
    </div>

    <div class="preview fade">
      <iframe
        title="Preview"
        class="preview-frame match-auth-bg"
        src="/extensions/nebula/preview/auth.php"
        loading="lazy">
      </iframe>
    </div>

    <%- include('../../partials/unsaved-modal') %>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const patSlider = document.querySelector('.option-container #pattern-size');
      if (patSlider) {
        const patTip = tippy(patSlider, { content: Math.floor(patSlider.value) + 'px', trigger: 'manual', arrow: false, animation: 'shift-away' });
        patSlider.addEventListener('input', () => { patTip.setContent(Math.floor(patSlider.value) + 'px'); patTip.show(); });
        patSlider.addEventListener('blur', () => patTip.hide());
      }

      document.getElementById("background-default").addEventListener("click", function () {
        document.getElementById("background-image-field").value = null;
        document.getElementById("magic-disabled").checked = true;
        document.getElementById("filter-disabled").click();
      });

      document.getElementById("background-image-field").addEventListener("change", function () {
        const elem = document.getElementById("background-image-field");
        if (elem.value == "") {
          document.getElementById("filter-disabled").checked = true;
          document.getElementById("background-default").checked = true;
        } else {
          document.getElementById("background-image").click();
          document.getElementById("magic-disabled").checked = true;
          if (document.getElementById("filter-disabled").checked) document.getElementById("filter-none").checked = true;
        }
      });

      if (document.getElementById("background-image-field").value == "") {
        document.getElementById("filter-disabled").checked = true;
      }
    });

    function bgDepend(event) {
      if (document.getElementById('background-image-field').value == '') {
        event.preventDefault();
        document.getElementById('background-image-field').focus();
      }
    }
    function magicBackground() {
      document.getElementById("background-image-field").value = null;
      document.getElementById("filter-disabled").click();
      document.getElementById("background-magic").checked = true;
    }
    function backgroundModal() {
      if (element("#background-image-field").value == "") modal('#magic-modal'); else modal('#background-modal');
    }
  </script>
</body>
</html>
