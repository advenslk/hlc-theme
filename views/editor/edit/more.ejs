<!DOCTYPE html>
<html lang="en" style="background-color: #070709">
<head>
  <meta charset="utf-8">
  <title>HelzerX 3D Theme Designer · Miscellaneous</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/x-icon" href="/extensions/nebula/editor/assets/favicon.ico">
  <link rel="stylesheet" href="../assets/base.css">
  <link rel="stylesheet" href="../assets/css/modes/previewless.css">
  <link rel="stylesheet" href="../assets/css/helzerx-designer.css">
  <script src="../assets/js/navigation.js"></script>
  <script src="../assets/js/editor.js"></script>
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>
  <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/animations/shift-away.css">
  <style>
    .match-dashboard-bg { background-color: <%= dbGet("nebula", "palette_dashboard_7") %> !important; }
    .match-auth-bg { background-color: <%= dbGet("nebula", "palette_auth_1") %> !important; }
  </style>
</head>

<body>
  <div class="container">
    <div class="navigation">
      <button onclick="navigationAction('admin')" to="admin" class="return-button" type="button"><i class="bi bi-arrow-90deg-left"></i></button>
      <div style="height: 80px;"></div>
      <button onclick="navigationAction('general')" to="general" class="navigation-button" type="button"><i class="bi bi-sliders2"></i></button>
      <button onclick="navigationAction('palette')" to="palette" class="navigation-button" type="button"><i class="bi bi-palette2"></i></button>
      <button onclick="navigationAction('sidebar')" to="sidebar" class="navigation-button" type="button"><i class="bi bi-layout-sidebar-inset"></i></button>
      <button onclick="navigationAction('dashboard')" to="dashboard" class="navigation-button" type="button"><i class="bi bi-grid-1x2"></i></button>
      <button onclick="navigationAction('authentication')" to="authentication" class="navigation-button" type="button"><i class="bi bi-box-arrow-in-right"></i></button>
      <button onclick="navigationAction('more')" to="more" class="navigation-button active" type="button"><i class="bi bi-nut"></i></button>
      <div class="save-padding"></div>
      <button onclick="saveAction()" class="save-button" type="button"><i class="bi bi-floppy-fill"></i></button>
    </div>

    <div class="editor fade">
      <%- include('../../partials/designer-toolbar') %>
      <form action="/admin/extensions/nebula" method="POST" id="editor-form" autocomplete="off">
        <div class="editor-container">
          <h2 class="editor-title">Miscellaneous</h2>
          <p class="editor-description">Advanced configuration, page indexing, and HelzerX CSS export.</p>

          <!-- Page indexing -->
          <div class="option">
            <p class="option-title">Page indexing</p>
            <input type="radio" id="pageindexing-on" name="page_indexing" value="1" class="hidden" <%= dbGet("nebula", "page_indexing") == "1" ? "checked" : "" %>>
            <label for="pageindexing-on" class="option-radio"><img src="../assets/images/more/pageindexing/on.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="pageindexing-off" name="page_indexing" value="0" class="hidden" <%= dbGet("nebula", "page_indexing") == "0" ? "checked" : "" %>>
            <label for="pageindexing-off" class="option-radio"><img src="../assets/images/more/pageindexing/off.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Automatically indexes extension pages into a 'more' menu on your sidebar.</p>
          </div>

          <!-- Export CSS -->
          <div class="option">
            <p class="option-title">Compiled HelzerX 3D Stylesheet</p>
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
              <a href="/extensions/nebula/theme.css" target="_blank" class="hx-designer-link gold">
                <i class="bi bi-download"></i>
                <span>Download theme.css</span>
              </a>
              <a href="/panel" class="hx-designer-link">
                <i class="bi bi-window-desktop"></i>
                <span>Open Client Panel</span>
              </a>
            </div>
            <p class="option-footer">Download the compiled CSS variables paired with HelzerX 3D styles for your Pterodactyl instance.</p>
          </div>

          <!-- Factory settings -->
          <div class="option">
            <p class="option-title">Factory settings</p>
            <button class="option-button button-danger height-auto width-auto force-square" onclick="notify('#notif-reset')" type="button"><i class="bi bi-trash3-fill" style="font-size: 40px"></i></button>
            <input type="radio" name="reset" id="reset" value="1" class="hidden">
            <p class="option-footer">Reset all changes back to HelzerX 3D Obsidian Gold factory defaults.</p>
          </div>
        </div>

        <div id="editor-submit">
          <input type="hidden" name="_endpoint" value="/extensions/nebula/editor/edit/more.php">
          <input type="hidden" name="_method" value="PATCH">
          <button type="submit" class="hidden" id="submit"></button>
        </div>
      </form>
    </div>

    <%- include('../../partials/unsaved-modal') %>

    <div id="notif-reset" class="notif">
      <div class="notif-hitbox"></div>
      <div class="notif-container">
        <h2 class="notif-title">
          <i class="bi bi-trash3-fill" style="margin-right: 4px;"></i>
          Reset Theme Configuration
        </h2>
        <p class="notif-text">Restore all configuration values to HelzerX 3D Obsidian Gold defaults.</p>
        <button class="notif-button notif-danger" id="reset-confirm" onclick="factoryReset()" type="button">Reset</button>
        <button class="button-close notif-button align-right" id="reset-cancel" type="button">Cancel</button>
      </div>
    </div>

    <div id="notif-reset-done" class="notif">
      <div class="notif-hitbox"></div>
      <div class="notif-container">
        <h2 class="notif-title">
          <i class="bi bi-check-circle-fill" style="margin-right: 4px;"></i>
          Reset complete
        </h2>
        <p class="notif-text">Configuration restored to HelzerX 3D defaults.</p>
        <button class="button-close notif-button" type="button">Dismiss</button>
      </div>
    </div>
  </div>

  <script>
    function factoryReset() {
      element("#reset-confirm").innerHTML = "<span style='opacity:0'>.</span>" + SPINNER_SM + "<span style='opacity:0'>.</span>";
      element("#reset-cancel").disabled = true;
      element("#reset-cancel").style.opacity = ".6";
      element("#notif-reset > .notif-hitbox").onclick = undefined;
      setTimeout(() => {
        element("input[name='_endpoint']").value = "/extensions/nebula/editor/edit/more.php";
        element("#reset").click();
        element("#submit").click();
      }, 600);
    }

    document.addEventListener("DOMContentLoaded", function () {
      const params = new URL(window.location).searchParams;
      if (params.get('reset') == "true") {
        notify("#notif-reset-done");
      }
    });
  </script>
</body>
</html>
