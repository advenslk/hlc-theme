<!DOCTYPE html>
<html lang="en" style="background-color: #070709">
<head>
  <meta charset="utf-8">
  <title>HelzerX 3D Theme Designer · Palette</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/x-icon" href="/extensions/nebula/editor/assets/favicon.ico">
  <link rel="stylesheet" href="../assets/base.css">
  <link rel="stylesheet" href="../assets/css/helzerx-designer.css">
  <script src="../assets/js/navigation.js"></script>
  <script src="../assets/js/editor.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/mdbassit/Coloris@latest/dist/coloris.min.css"/>
  <script src="https://cdn.jsdelivr.net/gh/mdbassit/Coloris@latest/dist/coloris.min.js"></script>
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>
  <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/animations/shift-away.css">
  <style>
    .match-dashboard-bg { background-color: <%= dbGet("nebula", "palette_dashboard_7") %> !important; }
    .match-auth-bg { background-color: <%= dbGet("nebula", "palette_auth_1") %> !important; }
    .hx-preset-swatch {
      display: inline-flex;
      flex-direction: column;
      justify-content: space-between;
      width: 118px;
      height: 65px;
      padding: 8px 10px;
      border-radius: 12px;
      background: linear-gradient(155deg, #16161d 0%, #070709 100%);
      border: 1px solid rgba(245, 176, 65, 0.5);
      box-shadow: 0 5px 0 0 rgba(5, 5, 8, 0.94), inset 0 1px 0 rgba(255, 255, 255, 0.16);
      vertical-align: top;
      cursor: pointer;
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
    }
    .hx-preset-swatch:hover {
      transform: translateY(-2px);
      border-color: #f5b041;
    }
    .hx-preset-swatch-bars {
      display: flex;
      gap: 4px;
    }
    .hx-preset-swatch-bars span {
      height: 10px;
      flex: 1;
      border-radius: 3px;
    }
    .hx-preset-swatch-label {
      font-size: 11px;
      font-weight: 700;
      color: #f5f5f7;
      letter-spacing: 0.02em;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="navigation">
      <button onclick="navigationAction('admin')" to="admin" class="return-button" type="button"><i class="bi bi-arrow-90deg-left"></i></button>
      <div style="height: 80px;"></div>
      <button onclick="navigationAction('general')" to="general" class="navigation-button" type="button"><i class="bi bi-sliders2"></i></button>
      <button onclick="navigationAction('palette')" to="palette" class="navigation-button active" type="button"><i class="bi bi-palette2"></i></button>
      <button onclick="navigationAction('sidebar')" to="sidebar" class="navigation-button" type="button"><i class="bi bi-layout-sidebar-inset"></i></button>
      <button onclick="navigationAction('dashboard')" to="dashboard" class="navigation-button" type="button"><i class="bi bi-grid-1x2"></i></button>
      <button onclick="navigationAction('authentication')" to="authentication" class="navigation-button" type="button"><i class="bi bi-box-arrow-in-right"></i></button>
      <button onclick="navigationAction('more')" to="more" class="navigation-button" type="button"><i class="bi bi-nut"></i></button>
      <div class="save-padding"></div>
      <button onclick="saveAction()" class="save-button" type="button"><i class="bi bi-floppy-fill"></i></button>
    </div>

    <div class="editor fade">
      <%- include('../../partials/designer-toolbar') %>
      <form action="/admin/extensions/nebula" method="POST" id="editor-form" autocomplete="off">
        <div class="editor-container">
          <h2 class="editor-title">Palette</h2>
          <p class="editor-description">Modify the Obsidian Gold color scheme and live panel surfaces.</p>

          <!-- Presets -->
          <div class="option">
            <p class="option-title">Presets</p>
            <input type="radio" id="preset-helzerx" name="palette_preset" value="" class="hidden">
            <label for="preset-helzerx" class="option-radio sm no-bg" onclick="applyPalette(event, 'helzerx')">
              <span class="hx-preset-swatch">
                <span class="hx-preset-swatch-bars">
                  <span style="background:#070709"></span>
                  <span style="background:#111116"></span>
                  <span style="background:#f5b041"></span>
                  <span style="background:#a569bd"></span>
                </span>
                <span class="hx-preset-swatch-label">HelzerX 3D</span>
              </span>
            </label>

            <input type="radio" id="preset-default" name="palette_preset" value="" class="hidden">
            <label for="preset-default" class="option-radio sm no-bg" onclick="applyPalette(event, 'default')">
              <img src="../assets/images/palette/presets/default.png" class="aspect-1:0.55"/>
            </label>

            <input type="radio" id="preset-slate" name="palette_preset" value="" class="hidden">
            <label for="preset-slate" class="option-radio sm no-bg" onclick="applyPalette(event, 'slate')">
              <img src="../assets/images/palette/presets/slate.png" class="aspect-1:0.55"/>
            </label>

            <input type="radio" id="preset-pyro" name="palette_preset" value="" class="hidden">
            <label for="preset-pyro" class="option-radio sm no-bg" onclick="applyPalette(event, 'pyro')">
              <img src="../assets/images/palette/presets/pyro.png" class="aspect-1:0.55"/>
            </label>

            <input type="radio" id="preset-leaf" name="palette_preset" value="" class="hidden">
            <label for="preset-leaf" class="option-radio sm no-bg" onclick="applyPalette(event, 'leaf')">
              <img src="../assets/images/palette/presets/leaf.png" class="aspect-1:0.55"/>
            </label>

            <input type="radio" id="preset-catppuccin" name="palette_preset" value="" class="hidden">
            <label for="preset-catppuccin" class="option-radio sm no-bg" onclick="applyPalette(event, 'catppuccin')">
              <img src="../assets/images/palette/presets/catppuccin.png" class="aspect-1:0.55"/>
            </label>
            <p class="option-footer">Apply HelzerX 3D Obsidian Gold or a classic preset palette.</p>
          </div>

          <!-- Dashboard palette -->
          <div class="option">
            <p class="option-title">Dashboard palette</p>
            <div>
              <% for (let i = 1; i <= 9; i++) { %>
                <input type="text" class="option-color" placeholder="#000000" id="palette_dashboard_<%= i %>" name="palette_dashboard_<%= i %>" value="<%= dbGet('nebula', 'palette_dashboard_' + i) %>" data-coloris onclick="focusDash()">
              <% } %>
            </div>
          </div>

          <!-- Utility colors -->
          <div class="option">
            <p class="option-title">Utility colors</p>
            <div>
              <input type="text" class="option-color" placeholder="#000000" id="palette_status_online" name="palette_status_online" value="<%= dbGet('nebula', 'palette_status_online') %>" data-coloris onclick="focusDash()">
              <input type="text" class="option-color" placeholder="#000000" id="palette_status_starting" name="palette_status_starting" value="<%= dbGet('nebula', 'palette_status_starting') %>" data-coloris onclick="focusDash()">
              <input type="text" class="option-color" placeholder="#000000" id="palette_status_error" name="palette_status_error" value="<%= dbGet('nebula', 'palette_status_error') %>" data-coloris onclick="focusDash()">
              <input type="text" class="option-color" placeholder="#000000" id="palette_status_offline" name="palette_status_offline" value="<%= dbGet('nebula', 'palette_status_offline') %>" data-coloris onclick="focusDash()">
            </div>
          </div>

          <!-- Sidebar palette -->
          <div class="option">
            <p class="option-title">Sidebar palette</p>
            <div>
              <% for (let i = 1; i <= 8; i++) { %>
                <input type="text" class="option-color" placeholder="#000000" id="palette_sidebar_<%= i %>" name="palette_sidebar_<%= i %>" value="<%= dbGet('nebula', 'palette_sidebar_' + i) %>" data-coloris onclick="focusDash()">
              <% } %>
            </div>
          </div>

          <!-- Authentication palette -->
          <div class="option">
            <p class="option-title">Authentication palette</p>
            <div>
              <% for (let i = 1; i <= 8; i++) { %>
                <input type="text" class="option-color" placeholder="#000000" id="palette_auth_<%= i %>" name="palette_auth_<%= i %>" value="<%= dbGet('nebula', 'palette_auth_' + i) %>" data-coloris onclick="focusAuth()">
              <% } %>
            </div>
          </div>
        </div>

        <div id="editor-picker"></div>
        <div id="editor-submit">
          <input type="hidden" name="_endpoint" value="/extensions/nebula/editor/edit/palette.php">
          <input type="hidden" name="_method" value="PATCH">
          <button type="submit" class="hidden" id="submit"></button>
        </div>
      </form>
    </div>

    <div class="preview fade">
      <iframe
        title="Preview"
        class="preview-frame sm"
        src="/extensions/nebula/preview/multipreview.php"
        loading="lazy">
