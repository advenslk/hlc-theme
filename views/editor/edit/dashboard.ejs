<!DOCTYPE html>
<html lang="en" style="background-color: #070709">
<head>
  <meta charset="utf-8">
  <title>HelzerX 3D Theme Designer · Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/x-icon" href="/extensions/nebula/editor/assets/favicon.ico">
  <link rel="stylesheet" href="../assets/base.css">
  <link rel="stylesheet" href="../assets/css/helzerx-designer.css">
  <script src="../assets/js/navigation.js"></script>
  <script src="../assets/js/editor.js"></script>
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>
  <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/animations/shift-away.css">
  <link rel="stylesheet" href="/extensions/nebula/libraries/patterns.css">
  <style>
    .match-dashboard-bg { background-color: <%= dbGet("nebula", "palette_dashboard_7") %> !important; }
    .match-auth-bg { background-color: <%= dbGet("nebula", "palette_auth_1") %> !important; }
  </style>
</head>

<body>
  <div class="container">
    <div class="navigation">
      <button onclick="navigationAction('admin')" to="admin" class="return-button" type="button"><i class="bi bi-arrow-90deg-left"></i></button>
      <div style="height: 80px;"></div>
      <button onclick="navigationAction('general')" to="general" class="navigation-button" type="button"><i class="bi bi-sliders2"></i></button>
      <button onclick="navigationAction('palette')" to="palette" class="navigation-button" type="button"><i class="bi bi-palette2"></i></button>
      <button onclick="navigationAction('sidebar')" to="sidebar" class="navigation-button" type="button"><i class="bi bi-layout-sidebar-inset"></i></button>
      <button onclick="navigationAction('dashboard')" to="dashboard" class="navigation-button active" type="button"><i class="bi bi-grid-1x2"></i></button>
      <button onclick="navigationAction('authentication')" to="authentication" class="navigation-button" type="button"><i class="bi bi-box-arrow-in-right"></i></button>
      <button onclick="navigationAction('more')" to="more" class="navigation-button" type="button"><i class="bi bi-nut"></i></button>
      <div class="save-padding"></div>
      <button onclick="saveAction()" class="save-button" type="button"><i class="bi bi-floppy-fill"></i></button>
    </div>

    <div class="editor fade">
      <%- include('../../partials/designer-toolbar') %>
      <form action="/admin/extensions/nebula" method="POST" id="editor-form" autocomplete="off">
        <div class="editor-container">
          <h2 class="editor-title">Dashboard</h2>
          <p class="editor-description">Customize the Pterodactyl dashboard layout, animations, and server surfaces.</p>

          <!-- Background -->
          <div class="option">
            <button class="modal-open" onclick="backgroundModal()" type="button" style="float: left"><i class="bi bi-plus-lg"></i></button>
            <p class="option-title with-button">Background</p>
            <input type="radio" id="background-default" name="background_image" value="" class="hidden" <%= (dbGet("nebula", "background_image") == "" && dbGet("nebula", "background_magic") == "") ? "checked" : "" %>/>
            <label for="background-default" class="option-radio sm aspect-square"><img src="../assets/images/authentication/background/default.png" loading="lazy"/></label>
            <input type="radio" id="background-magic" name="background_image" class="hidden" <%= dbGet("nebula", "background_magic") != "" ? "checked" : "" %>/>
            <label for="background-magic" class="option-radio sm aspect-square" onclick="event.preventDefault();modal('#magic-modal');"><img src="../assets/images/dashboard/background/magic.png" loading="lazy"/></label>
            <input type="radio" id="background-image" name="background_image" class="hidden" <%= dbGet("nebula", "background_image") != "" ? "checked" : "" %>/>
            <label for="background-image" class="option-radio sm aspect-square" onclick="event.preventDefault();modal('#background-modal');"><img src="../assets/images/dashboard/background/image.png" loading="lazy"/></label>
            <p class="option-footer">Customize the background image or pattern of your Pterodactyl panel.</p>
          </div>

          <!-- Server list -->
          <div class="option">
            <button class="modal-open" onclick="modal('#serverlist-modal')" type="button" style="float: left"><i class="bi bi-plus-lg"></i></button>
            <p class="option-title with-button">Server list</p>
            <input type="radio" id="serverlist-cards" name="server_list" value="cards" class="hidden" <%= dbGet("nebula", "server_list") == "cards" ? "checked" : "" %>>
            <label for="serverlist-cards" class="option-radio"><img src="../assets/images/dashboard/serverlist/cards.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="serverlist-list" name="server_list" value="list" class="hidden" <%= dbGet("nebula", "server_list") == "list" ? "checked" : "" %>>
            <label for="serverlist-list" class="option-radio"><img src="../assets/images/dashboard/serverlist/list.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Configure how servers display in the dashboard list.</p>
          </div>

          <!-- Animations -->
          <div class="option">
            <p class="option-title">Animations</p>
            <input type="radio" id="animations-fadeup" name="animations" value="fadeup" class="hidden" <%= dbGet("nebula", "animations") == "fadeup" ? "checked" : "" %>>
            <label for="animations-fadeup" class="option-radio"><img src="../assets/images/dashboard/animations/fadeup.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="animations-zoomout" name="animations" value="zoomout" class="hidden" <%= dbGet("nebula", "animations") == "zoomout" ? "checked" : "" %>>
            <label for="animations-zoomout" class="option-radio"><img src="../assets/images/dashboard/animations/zoomout.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="animations-fadein" name="animations" value="fadein" class="hidden" <%= dbGet("nebula", "animations") == "fadein" ? "checked" : "" %>>
            <label for="animations-fadein" class="option-radio"><img src="../assets/images/dashboard/animations/fadein.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="animations-disabled" name="animations" value="disabled" class="hidden" <%= dbGet("nebula", "animations") == "disabled" ? "checked" : "" %>>
            <label for="animations-disabled" class="option-radio"><img src="../assets/images/dashboard/animations/disabled.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Choose how elements animate in on the panel.</p>
          </div>

          <!-- Keybinds -->
          <div class="option">
            <button class="modal-open" onclick="modal('#keybinds-modal')" type="button" style="float: left"><i class="bi bi-plus-lg"></i></button>
            <p class="option-title with-button">Keybinds</p>
            <input type="radio" id="keybinds-on" name="keyboard_shortcuts" value="1" class="hidden" <%= dbGet("nebula", "keyboard_shortcuts") == "1" ? "checked" : "" %>>
            <label for="keybinds-on" class="option-radio"><img src="../assets/images/dashboard/keybinds/on.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="keybinds-off" name="keyboard_shortcuts" value="0" class="hidden" <%= dbGet("nebula", "keyboard_shortcuts") == "0" ? "checked" : "" %>>
            <label for="keybinds-off" class="option-radio"><img src="../assets/images/dashboard/keybinds/off.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Enable or disable keyboard shortcuts.</p>
          </div>

          <!-- Graphs -->
          <div class="option">
            <p class="option-title">Graphs</p>
            <input type="radio" id="graphs-on" name="server_overview_graphs" value="1" class="hidden" <%= dbGet("nebula", "server_overview_graphs") == "1" ? "checked" : "" %>>
            <label for="graphs-on" class="option-radio"><img src="../assets/images/dashboard/graphs/on.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="graphs-off" name="server_overview_graphs" value="0" class="hidden" <%= dbGet("nebula", "server_overview_graphs") == "0" ? "checked" : "" %>>
            <label for="graphs-off" class="option-radio"><img src="../assets/images/dashboard/graphs/off.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Display or hide resource telemetry graphs on server views.</p>
          </div>

          <!-- Power button style -->
          <div class="option">
            <p class="option-title">Power button style</p>
            <input type="radio" id="coloredbtn-on" name="server_colored_power" value="1" class="hidden" <%= dbGet("nebula", "server_colored_power") == "1" ? "checked" : "" %>>
            <label for="coloredbtn-on" class="option-radio"><img src="../assets/images/dashboard/coloredbtn/on.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="coloredbtn-off" name="server_colored_power" value="0" class="hidden" <%= dbGet("nebula", "server_colored_power") == "0" ? "checked" : "" %>>
            <label for="coloredbtn-off" class="option-radio"><img src="../assets/images/dashboard/coloredbtn/off.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Configure how power action buttons appear.</p>
          </div>

          <!-- Watermark -->
          <div class="option">
            <p class="option-title">Watermark</p>
            <input type="radio" id="watermark-on" name="watermark" value="1" class="hidden" <%= dbGet("nebula", "watermark") == "1" ? "checked" : "" %>>
            <label for="watermark-on" class="option-radio"><img src="../assets/images/dashboard/watermark/on.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="watermark-off" name="watermark" value="0" class="hidden" <%= dbGet("nebula", "watermark") == "0" ? "checked" : "" %>>
            <label for="watermark-off" class="option-radio"><img src="../assets/images/dashboard/watermark/off.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Show or hide the footer watermark on the dashboard.</p>
          </div>

          <!-- Border radius -->
          <div class="option">
            <p class="option-title">Border radius</p>
            <div class="option-container">
              <input type="range" id="border-radius" min="0" max="20" name="border_radius" value="<%= dbGet("nebula", "border_radius") %>" step="1" class="option-slider">
            </div>
            <p class="option-footer">Adjust the border radius of dashboard surfaces.</p>
          </div>
        </div>

        <!-- Background modal -->
        <div class="editor-modal" id="background-modal">
          <button class="modal-close" onclick="closeModal('#background-modal')" type="button" style="float: left"><i class="bi bi-chevron-left"></i></button>
          <h2 class="editor-title with-button">Background image</h2>
          <p class="editor-description">Change your Pterodactyl panel's background.</p>

          <div class="option">
            <p class="option-title">Background image</p>
            <div class="option-container with-margin">
              <span class="option-icon"><i class="bi bi-image"></i></span>
              <input type="text" id="background-image-field" name="background_image" class="option-input with-icon" placeholder="https://helzerx.net/wallpaper.jpg" value="<%= dbGet("nebula", "background_image") %>">
            </div>
            <p class="option-footer">Use a custom background image URL.</p>
          </div>

          <div class="option">
            <p class="option-title">Filters</p>
            <input type="radio" id="filter-disabled" name="background_appearance" value="0" class="hidden"/>
            <input type="radio" id="filter-none" name="background_appearance" value="0" class="hidden" <%= dbGet("nebula", "background_appearance") == "0" ? "checked" : "" %>/>
            <label for="filter-none" class="option-radio" onclick="bgDepend(event)"><img src="../assets/images/dashboard/filters/none.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="filter-blur" name="background_appearance" value="1" class="hidden" <%= dbGet("nebula", "background_appearance") == "1" ? "checked" : "" %>/>
            <label for="filter-blur" class="option-radio" onclick="bgDepend(event)"><img src="../assets/images/dashboard/filters/blur.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="filter-dim" name="background_appearance" value="2" class="hidden" <%= dbGet("nebula", "background_appearance") == "2" ? "checked" : "" %>/>
            <label for="filter-dim" class="option-radio" onclick="bgDepend(event)"><img src="../assets/images/dashboard/filters/dim.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Change the filter of your custom background image.</p>
          </div>

          <div class="option">
            <p class="option-title">Transparency</p>
            <input type="radio" id="transparency-disabled" name="dashboard_transparency" value="0" class="hidden"/>
            <input type="radio" id="transparency-none" name="dashboard_transparency" value="0" class="hidden" <%= dbGet("nebula", "dashboard_transparency") == "0" ? "checked" : "" %>/>
            <label for="transparency-none" class="option-radio" onclick="bgDepend(event)"><img src="../assets/images/dashboard/transparency/none.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="transparency-subtle" name="dashboard_transparency" value="1" class="hidden" <%= dbGet("nebula", "dashboard_transparency") == "1" ? "checked" : "" %>/>
            <label for="transparency-subtle" class="option-radio" onclick="bgDepend(event)"><img src="../assets/images/dashboard/transparency/subtle.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="transparency-transparent" name="dashboard_transparency" value="2" class="hidden" <%= dbGet("nebula", "dashboard_transparency") == "2" ? "checked" : "" %>/>
            <label for="transparency-transparent" class="option-radio" onclick="bgDepend(event)"><img src="../assets/images/dashboard/transparency/transparent.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="transparency-max" name="dashboard_transparency" value="3" class="hidden" <%= dbGet("nebula", "dashboard_transparency") == "3" ? "checked" : "" %>/>
            <label for="transparency-max" class="option-radio" onclick="bgDepend(event)"><img src="../assets/images/dashboard/transparency/max.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Customize surface translucency when using custom backgrounds.</p>
          </div>
        </div>

        <!-- Magic background modal -->
        <div class="editor-modal" id="magic-modal">
          <button class="modal-close" onclick="closeModal('#magic-modal')" type="button" style="float: left"><i class="bi bi-chevron-left"></i></button>
          <h2 class="editor-title with-button">Background pattern</h2>
          <p class="editor-description">Use a geometric pattern as your panel background.</p>

          <div class="option">
            <p class="option-title">Pattern</p>
            <input type="radio" id="magic-disabled" name="background_magic" value="" class="hidden" <%= dbGet("nebula", "background_magic") == "" ? "checked" : "" %>/>
            <% const patterns = ['tiles','cubes','rotated-squares','l-shape','zig-zag','wavy-checkerboard','chevrons','houndstooth','quarter-circles','diagonal-rectangles','alternating-arc','rotated-rectangles','concentric-arrows','outline-triangles','moon','polka']; %>
            <% patterns.forEach(p => { %>
              <input type="radio" id="magic-<%= p %>" name="background_magic" value="<%= p %>" class="hidden" <%= dbGet("nebula", "background_magic") == p ? "checked" : "" %>/>
              <label for="magic-<%= p %>" onclick="magicBackground()" class="option-radio sm aspect-square pattern-label">
                <img class="pattern-preview <%= p %>" src="/extensions/nebula/libraries/assets/transparent.png" loading="lazy"/>
              </label>
            <% }); %>
            <p class="option-footer">Choose a geometric pattern.</p>
          </div>

          <div class="option">
            <p class="option-title">Size</p>
            <div class="option-container">
              <input type="range" id="pattern-size" min="50" max="500" name="background_magicsize" value="<%= dbGet("nebula", "background_magicsize") %>" step="5" class="option-slider">
            </div>
            <p class="option-footer">Adjust pattern scale.</p>
          </div>
        </div>

        <!-- Keybinds modal -->
        <div class="editor-modal" id="keybinds-modal">
          <button class="modal-close" onclick="closeModal('#keybinds-modal')" type="button" style="float: left"><i class="bi bi-chevron-left"></i></button>
          <h2 class="editor-title with-button">Keybinds</h2>
          <p class="editor-description">Additional options related to the keybinds overlay.</p>
          <div class="option">
            <p class="option-title">Display mode</p>
            <input type="radio" id="displaymode-prefer-icons" name="keybind_icons" value="1" class="hidden" <%= dbGet("nebula", "keybind_icons") == "1" ? "checked" : "" %>>
            <label for="displaymode-prefer-icons" class="option-radio sm aspect-square"><img src="../assets/images/dashboard/keybinds/prefer-icons.png" loading="lazy"/></label>
            <input type="radio" id="displaymode-text-only" name="keybind_icons" value="0" class="hidden" <%= dbGet("nebula", "keybind_icons") == "0" ? "checked" : "" %>>
            <label for="displaymode-text-only" class="option-radio sm aspect-square"><img src="../assets/images/dashboard/keybinds/text-only.png" loading="lazy"/></label>
            <p class="option-footer">Choose how shortcut names render.</p>
          </div>
        </div>

        <!-- Serverlist modal -->
        <div class="editor-modal" id="serverlist-modal">
          <button class="modal-close" onclick="closeModal('#serverlist-modal')" type="button" style="float: left"><i class="bi bi-chevron-left"></i></button>
          <h2 class="editor-title with-button">Server list</h2>
          <p class="editor-description">Additional options related to the server list.</p>
          <div class="option">
            <p class="option-title">Status gradient</p>
            <input type="radio" id="statusgradient-default" name="statusgradient_style" value="default" class="hidden" <%= dbGet("nebula", "statusgradient_style") == "default" ? "checked" : "" %>>
            <label for="statusgradient-default" class="option-radio"><img src="../assets/images/dashboard/statusgradient/default.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="statusgradient-flat" name="statusgradient_style" value="flat" class="hidden" <%= dbGet("nebula", "statusgradient_style") == "flat" ? "checked" : "" %>>
            <label for="statusgradient-flat" class="option-radio"><img src="../assets/images/dashboard/statusgradient/flat.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Enable or disable status gradient highlights on server cards.</p>
          </div>
        </div>

        <div id="editor-submit">
          <input type="hidden" name="_endpoint" value="/extensions/nebula/editor/edit/dashboard.php">
          <input type="hidden" name="_method" value="PATCH">
          <button type="submit" class="hidden" id="submit"></button>
        </div>
      </form>
    </div>

    <div class="preview fade">
      <iframe
        title="Preview"
        class="preview-frame match-dashboard-bg"
        src="/preview/panel"
        loading="lazy">
      </iframe>
    </div>

    <%- include('../../partials/unsaved-modal') %>
  </div>

  <script>
    const params = new URL(window.location).searchParams;
    if (params.get('location') != undefined) {
      element(".preview-frame").src = params.get('location');
    }

    document.addEventListener("DOMContentLoaded", function () {
      const brSlider = document.querySelector('.option-container #border-radius');
      if (brSlider) {
        const brTip = tippy(brSlider, { content: Math.floor(brSlider.value) + 'px', trigger: 'manual', arrow: false, animation: 'shift-away' });
        brSlider.addEventListener('input', () => { brTip.setContent(Math.floor(brSlider.value) + 'px'); brTip.show(); });
        brSlider.addEventListener('blur', () => brTip.hide());
      }
      const patSlider = document.querySelector('.option-container #pattern-size');
      if (patSlider) {
        const patTip = tippy(patSlider, { content: Math.floor(patSlider.value) + 'px', trigger: 'manual', arrow: false, animation: 'shift-away' });
        patSlider.addEventListener('input', () => { patTip.setContent(Math.floor(patSlider.value) + 'px'); patTip.show(); });
        patSlider.addEventListener('blur', () => patTip.hide());
      }

      document.getElementById("background-default").addEventListener("click", function () {
        document.getElementById("background-image-field").value = null;
        document.getElementById("magic-disabled").checked = true;
        document.getElementById("filter-disabled").click();
        document.getElementById("transparency-disabled").click();
      });

      document.getElementById("background-image-field").addEventListener("change", function () {
        const elem = document.getElementById("background-image-field");
        if (elem.value == "") {
          document.getElementById("filter-disabled").checked = true;
          document.getElementById("transparency-disabled").checked = true;
          document.getElementById("background-default").checked = true;
        } else {
          document.getElementById("background-image").click();
          document.getElementById("magic-disabled").checked = true;
          if (document.getElementById("filter-disabled").checked) document.getElementById("filter-none").checked = true;
          if (document.getElementById("transparency-disabled").checked) document.getElementById("transparency-none").checked = true;
        }
      });

      if (document.getElementById("background-image-field").value == "") {
        document.getElementById("filter-disabled").checked = true;
        document.getElementById("transparency-disabled").checked = true;
      }
    });

    function bgDepend(event) {
      if (document.getElementById('background-image-field').value == '') {
        event.preventDefault();
        document.getElementById('background-image-field').focus();
      }
    }
    function magicBackground() {
      document.getElementById("background-image-field").value = null;
      document.getElementById("filter-disabled").click();
      document.getElementById("transparency-disabled").click();
      document.getElementById("background-magic").checked = true;
    }
    function backgroundModal() {
      if (element("#background-image-field").value == "") modal('#magic-modal'); else modal('#background-modal');
    }
  </script>
</body>
</html>
