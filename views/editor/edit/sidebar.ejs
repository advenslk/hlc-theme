<!DOCTYPE html>
<html lang="en" style="background-color: #070709">
<head>
  <meta charset="utf-8">
  <title>HelzerX 3D Theme Designer · Sidebar</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/x-icon" href="/extensions/nebula/editor/assets/favicon.ico">
  <link rel="stylesheet" href="../assets/base.css">
  <link rel="stylesheet" href="../assets/css/helzerx-designer.css">
  <script src="../assets/js/navigation.js"></script>
  <script src="../assets/js/editor.js"></script>
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>
  <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/animations/shift-away.css">
  <style>
    .match-dashboard-bg { background-color: <%= dbGet("nebula", "palette_dashboard_7") %> !important; }
    .match-auth-bg { background-color: <%= dbGet("nebula", "palette_auth_1") %> !important; }
  </style>
</head>

<body>
  <div class="container">
    <div class="navigation">
      <button onclick="navigationAction('admin')" to="admin" class="return-button" type="button"><i class="bi bi-arrow-90deg-left"></i></button>
      <div style="height: 80px;"></div>
      <button onclick="navigationAction('general')" to="general" class="navigation-button" type="button"><i class="bi bi-sliders2"></i></button>
      <button onclick="navigationAction('palette')" to="palette" class="navigation-button" type="button"><i class="bi bi-palette2"></i></button>
      <button onclick="navigationAction('sidebar')" to="sidebar" class="navigation-button active" type="button"><i class="bi bi-layout-sidebar-inset"></i></button>
      <button onclick="navigationAction('dashboard')" to="dashboard" class="navigation-button" type="button"><i class="bi bi-grid-1x2"></i></button>
      <button onclick="navigationAction('authentication')" to="authentication" class="navigation-button" type="button"><i class="bi bi-box-arrow-in-right"></i></button>
      <button onclick="navigationAction('more')" to="more" class="navigation-button" type="button"><i class="bi bi-nut"></i></button>
      <div class="save-padding"></div>
      <button onclick="saveAction()" class="save-button" type="button"><i class="bi bi-floppy-fill"></i></button>
    </div>

    <div class="editor fade">
      <%- include('../../partials/designer-toolbar') %>
      <form action="/admin/extensions/nebula" method="POST" id="editor-form" autocomplete="off">
        <div class="editor-container">
          <h2 class="editor-title">Sidebar</h2>
          <p class="editor-description">Customize how the sidebar behaves and looks.</p>

          <!-- Icon theme -->
          <div class="option">
            <button class="modal-open" onclick="modal('#icon-modal')" type="button" style="float: left"><i class="bi bi-plus-lg"></i></button>
            <p class="option-title with-button">Icon theme</p>
            <% const iconThemes = [
              { id: 'bootstrap', img: 'bootstrap', val: 'bootstrap' },
              { id: 'feather', img: 'feather', val: 'feather' },
              { id: 'lucide', img: 'lucide', val: 'lucide' },
              { id: 'material', img: 'material', val: 'material' },
              { id: 'material-light', img: 'material-light', val: 'material-light' },
              { id: 'fontawesome', img: 'fontawesome', val: 'fontawesome' },
              { id: 'eva-outline', img: 'eva-outline', val: 'eva-outline' },
              { id: 'eva-solid', img: 'eva-solid', val: 'eva-solid' },
              { id: 'remix-outline', img: 'remix-outline', val: 'remix-outline' },
              { id: 'remix-solid', img: 'remix-solid', val: 'remix-solid' },
              { id: 'tabler', img: 'tabler', val: 'tabler' },
              { id: 'octicons', img: 'octicons', val: 'octicons' },
              { id: 'akaricons', img: 'akaricons', val: 'akar-icons' },
              { id: 'hugeicons-solid', img: 'hugeicons-solid', val: 'hugeicons-solid' },
              { id: 'hugeicons-stroke', img: 'hugeicons-stroke', val: 'hugeicons-stroke' }
            ]; %>
            <% iconThemes.forEach(t => { %>
              <input type="radio" id="icontheme-<%= t.id %>" name="icon_fallback" value="<%= t.val %>" class="hidden" <%= dbGet("nebula", "icon_fallback") == t.val ? "checked" : "" %>>
              <label for="icontheme-<%= t.id %>" class="option-radio sm aspect-square">
                <img src="../assets/images/sidebar/icontheme/<%= t.img %>.png" loading="lazy"/>
              </label>
            <% }); %>
            <p class="option-footer">Pick the icon theme that best suits your panel.</p>
          </div>

          <!-- Type -->
          <div class="option">
            <button class="modal-open" onclick="modal('#sidebar-modal')" type="button" style="float: left"><i class="bi bi-plus-lg"></i></button>
            <p class="option-title with-button">Type</p>
            <input type="radio" id="type-icons" name="sidebar_full" value="0" class="hidden" <%= dbGet("nebula", "sidebar_full") == "0" ? "checked" : "" %>>
            <label for="type-icons" class="option-radio">
              <img src="../assets/images/sidebar/type/icons.png" loading="lazy" class="aspect-16:9"/>
            </label>
            <input type="radio" id="type-wide" name="sidebar_full" value="1" class="hidden" <%= dbGet("nebula", "sidebar_full") == "1" ? "checked" : "" %>>
            <label for="type-wide" class="option-radio">
              <img src="../assets/images/sidebar/type/wide.png" loading="lazy" class="aspect-16:9"/>
            </label>
            <p class="option-footer">Choose between an icon-only sidebar or one with text labels.</p>
          </div>

          <!-- Hover animation -->
          <div class="option">
            <p class="option-title">Hover animation</p>
            <input type="radio" id="hover-popout" name="sidebar_hover" value="popout" class="hidden" <%= dbGet("nebula", "sidebar_hover") == "popout" ? "checked" : "" %>>
            <label for="hover-popout" class="option-radio"><img src="../assets/images/sidebar/hover/popout.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="hover-expand" name="sidebar_hover" value="expand" class="hidden" <%= dbGet("nebula", "sidebar_hover") == "expand" ? "checked" : "" %>>
            <label for="hover-expand" class="option-radio"><img src="../assets/images/sidebar/hover/expand.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="hover-disabled" name="sidebar_hover" value="disabled" class="hidden" <%= dbGet("nebula", "sidebar_hover") == "disabled" ? "checked" : "" %>>
            <label for="hover-disabled" class="option-radio"><img src="../assets/images/sidebar/hover/disabled.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Optionally add a hover animation to the sidebar buttons.</p>
          </div>

          <!-- Appearance -->
          <div class="option">
            <p class="option-title">Appearance</p>
            <input type="radio" id="appearance-solid" name="sidebar_background" value="default" class="hidden" <%= dbGet("nebula", "sidebar_background") == "default" ? "checked" : "" %>>
            <label for="appearance-solid" class="option-radio"><img src="../assets/images/sidebar/appearance/solid.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="appearance-glass" name="sidebar_background" value="blurred" class="hidden" <%= dbGet("nebula", "sidebar_background") == "blurred" ? "checked" : "" %>>
            <label for="appearance-glass" class="option-radio"><img src="../assets/images/sidebar/appearance/glass.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Customize the appearance of the sidebar.</p>
          </div>

          <!-- Global navigation -->
          <div class="option">
            <p class="option-title">Global navigation</p>
            <input type="radio" id="globalnavigation-show" name="sidebar_always_visible_buttons" value="1" class="hidden" <%= dbGet("nebula", "sidebar_always_visible_buttons") == "1" ? "checked" : "" %>>
            <label for="globalnavigation-show" class="option-radio"><img src="../assets/images/sidebar/globalnavigation/show.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="globalnavigation-hide" name="sidebar_always_visible_buttons" value="0" class="hidden" <%= dbGet("nebula", "sidebar_always_visible_buttons") == "0" ? "checked" : "" %>>
            <label for="globalnavigation-hide" class="option-radio"><img src="../assets/images/sidebar/globalnavigation/hide.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Hide global navigation on account and server pages.</p>
          </div>

          <!-- Separators -->
          <div class="option">
            <p class="option-title">Separators</p>
            <input type="radio" id="separators-enabled" name="sidebar_separators" value="1" class="hidden" <%= dbGet("nebula", "sidebar_separators") == "1" ? "checked" : "" %>>
            <label for="separators-enabled" class="option-radio"><img src="../assets/images/sidebar/separators/on.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="separators-disabled" name="sidebar_separators" value="0" class="hidden" <%= dbGet("nebula", "sidebar_separators") == "0" ? "checked" : "" %>>
            <label for="separators-disabled" class="option-radio"><img src="../assets/images/sidebar/separators/off.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Allows hiding of sidebar category separators.</p>
          </div>

          <!-- Border radius -->
          <div class="option">
            <p class="option-title">Border radius</p>
            <div class="option-container">
              <input type="range" id="border-radius" min="0" max="20" name="sidebar_border_radius" value="<%= dbGet("nebula", "sidebar_border_radius") %>" step="1" class="option-slider">
            </div>
            <p class="option-footer">Adjust the border radius of sidebar elements.</p>
          </div>
        </div>

        <!-- Icon modal -->
        <div class="editor-modal" id="icon-modal">
          <button class="modal-close" onclick="closeModal('#icon-modal')" type="button" style="float: left"><i class="bi bi-chevron-left"></i></button>
          <h2 class="editor-title with-button">Icon theme</h2>
          <p class="editor-description">Create icon overrides and change the icon scale to make the sidebar truly yours.</p>

          <div class="editor-alert" id="type-wide-alert">
            <p class="alert-text">Options listed here only work on <u>icon-only</u> sidebar. Editing options on this page will automatically <u>switch your sidebar setting</u> back to icon-only.</p>
          </div>

          <div class="opacity-container" id="icon-modal-opacity">
            <div class="option">
              <p class="option-title">Icon scale</p>
              <div class="option-container">
                <input type="range" id="icon-scale" min="0.1" max="1" name="icon_scale" value="<%= dbGet("nebula", "icon_scale") %>" step="0.05" class="option-slider">
              </div>
              <p class="option-footer">Customize the size sidebar icons display at.</p>
            </div>

            <div class="option">
              <p class="option-title">Global</p>
              <% const globalIcons = [
                { id: 'icon-home', name: 'sidebar_home', icon: 'bi-house-fill', label: 'Home' },
                { id: 'icon-admin', name: 'sidebar_admin', icon: 'bi-gear-fill', label: 'Admin' },
                { id: 'icon-account', name: 'sidebar_account', icon: 'bi-person-fill', label: 'Account' },
                { id: 'icon-logout', name: 'sidebar_logout', icon: 'bi-door-closed-fill', label: 'Logout' },
              ]; %>
              <% globalIcons.forEach(item => { %>
                <div class="option-container with-margin">
                  <span class="option-icon"><i class="bi <%= item.icon %>"></i></span>
                  <input onclick="element('#type-icons').click()" type="text" id="<%= item.id %>" name="<%= item.name %>" class="option-input with-icon" placeholder="https://helzerx.net/icons/<%= item.name %>.png" value="<%= dbGet('nebula', item.name) %>">
                </div>
              <% }); %>
            </div>

            <div class="option">
              <p class="option-title">Account</p>
              <% const acctIcons = [
                { id: 'icon-account-account', name: 'sidebar_account_account', icon: 'bi-emoji-smile-fill' },
                { id: 'icon-account-api', name: 'sidebar_account_api', icon: 'bi-globe' },
                { id: 'icon-account-ssh', name: 'sidebar_account_ssh', icon: 'bi-key-fill' },
                { id: 'icon-account-activity', name: 'sidebar_account_activity', icon: 'bi-clipboard-fill' },
                { id: 'icon-account-more', name: 'sidebar_account_more', icon: 'bi-three-dots' },
              ]; %>
              <% acctIcons.forEach(item => { %>
                <div class="option-container with-margin">
                  <span class="option-icon"><i class="bi <%= item.icon %>"></i></span>
                  <input onclick="element('#type-icons').click()" type="text" id="<%= item.id %>" name="<%= item.name %>" class="option-input with-icon" placeholder="https://helzerx.net/icons/<%= item.name %>.png" value="<%= dbGet('nebula', item.name) %>">
                </div>
              <% }); %>
            </div>

            <div class="option">
              <p class="option-title">Server</p>
              <% const srvIcons = [
                { id: 'icon-server-terminal', name: 'sidebar_server_terminal', icon: 'bi-terminal-fill' },
                { id: 'icon-server-files', name: 'sidebar_server_files', icon: 'bi-folder-fill' },
                { id: 'icon-server-databases', name: 'sidebar_server_databases', icon: 'bi-database-fill' },
                { id: 'icon-server-schedules', name: 'sidebar_server_schedules', icon: 'bi-calendar-fill' },
                { id: 'icon-server-users', name: 'sidebar_server_users', icon: 'bi-people-fill' },
                { id: 'icon-server-backups', name: 'sidebar_server_backups', icon: 'bi-archive-fill' },
                { id: 'icon-server-network', name: 'sidebar_server_network', icon: 'bi-reception-4' },
                { id: 'icon-server-startup', name: 'sidebar_server_startup', icon: 'bi-plug-fill' },
                { id: 'icon-server-settings', name: 'sidebar_server_settings', icon: 'bi-gear-fill' },
                { id: 'icon-server-activity', name: 'sidebar_server_activity', icon: 'bi-clipboard-fill' },
                { id: 'icon-server-more', name: 'sidebar_server_more', icon: 'bi-three-dots' },
              ]; %>
              <% srvIcons.forEach(item => { %>
                <div class="option-container with-margin">
                  <span class="option-icon"><i class="bi <%= item.icon %>"></i></span>
                  <input onclick="element('#type-icons').click()" type="text" id="<%= item.id %>" name="<%= item.name %>" class="option-input with-icon" placeholder="https://helzerx.net/icons/<%= item.name %>.png" value="<%= dbGet('nebula', item.name) %>">
                </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- Sidebar modal -->
        <div class="editor-modal" id="sidebar-modal">
          <button class="modal-close" onclick="closeModal('#sidebar-modal')" type="button" style="float: left"><i class="bi bi-chevron-left"></i></button>
          <h2 class="editor-title with-button">Sidebar type</h2>
          <p class="editor-description">Additional options related to the sidebar type setting.</p>

          <div class="editor-alert">
            <p class="alert-text">Options listed here are specific to your <u>selected sidebar type</u>.</p>
          </div>

          <div class="option" id="option-tooltip">
            <p class="option-title">Tooltip</p>
            <input type="radio" id="tooltip-aligned" name="sidebar_hover_tooltip" value="2" class="hidden" <%= dbGet("nebula", "sidebar_hover_tooltip") == "2" ? "checked" : "" %>>
            <label onclick="element('#type-icons').click()" for="tooltip-aligned" class="option-radio"><img src="../assets/images/sidebar/tooltip/aligned.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="tooltip-default" name="sidebar_hover_tooltip" value="1" class="hidden" <%= dbGet("nebula", "sidebar_hover_tooltip") == "1" ? "checked" : "" %>>
            <label onclick="element('#type-icons').click()" for="tooltip-default" class="option-radio"><img src="../assets/images/sidebar/tooltip/default.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="tooltip-off" name="sidebar_hover_tooltip" value="0" class="hidden" <%= dbGet("nebula", "sidebar_hover_tooltip") == "0" ? "checked" : "" %>>
            <label onclick="element('#type-icons').click()" for="tooltip-off" class="option-radio"><img src="../assets/images/sidebar/tooltip/off.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Choose how the sidebar hover tooltip displays.</p>
          </div>

          <div class="option" id="option-buttonstyle">
            <p class="option-title">Button style</p>
            <input type="radio" id="buttonstyle-default" name="sidebar_buttonstyle" value="0" class="hidden" <%= dbGet("nebula", "sidebar_buttonstyle") == "0" ? "checked" : "" %>>
            <label onclick="element('#type-wide').click()" for="buttonstyle-default" class="option-radio"><img src="../assets/images/sidebar/buttonstyle/default.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="buttonstyle-line" name="sidebar_buttonstyle" value="1" class="hidden" <%= dbGet("nebula", "sidebar_buttonstyle") == "1" ? "checked" : "" %>>
            <label onclick="element('#type-wide').click()" for="buttonstyle-line" class="option-radio"><img src="../assets/images/sidebar/buttonstyle/line.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="buttonstyle-outline" name="sidebar_buttonstyle" value="2" class="hidden" <%= dbGet("nebula", "sidebar_buttonstyle") == "2" ? "checked" : "" %>>
            <label onclick="element('#type-wide').click()" for="buttonstyle-outline" class="option-radio"><img src="../assets/images/sidebar/buttonstyle/outline.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Customize how buttons display in the full-size sidebar.</p>
          </div>

          <div class="option" id="option-customlogo">
            <p class="option-title">Custom logo</p>
            <div class="option-container with-margin" onclick="element('#type-wide').click()">
              <span class="option-icon"><i class="bi bi-image"></i></span>
              <input type="text" id="custom-logo-field" name="sidebar_customlogo" class="option-input with-icon" placeholder="https://helzerx.net/logo.png" value="<%= dbGet("nebula", "sidebar_customlogo") %>">
            </div>
            <p class="option-footer">Add your own logo to the full-width sidebar.</p>
          </div>
        </div>

        <div id="editor-submit">
          <input type="hidden" name="_endpoint" value="/extensions/nebula/editor/edit/sidebar.php">
          <input type="hidden" name="_method" value="PATCH">
          <button type="submit" class="hidden" id="submit"></button>
        </div>
      </form>
    </div>

    <div class="preview fade">
      <iframe
        title="Preview"
        class="preview-frame match-dashboard-bg"
        src="/preview/panel"
        loading="lazy">
      </iframe>
    </div>

    <%- include('../../partials/unsaved-modal') %>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const brSlider = document.querySelector('.option-container #border-radius');
      if (brSlider) {
        const brTip = tippy(brSlider, { content: Math.floor(brSlider.value) + 'px', trigger: 'manual', arrow: false, animation: 'shift-away' });
        brSlider.addEventListener('input', () => { brTip.setContent(Math.floor(brSlider.value) + 'px'); brTip.show(); });
        brSlider.addEventListener('blur', () => brTip.hide());
      }
      const icSlider = document.querySelector('.option-container #icon-scale');
      if (icSlider) {
        const icTip = tippy(icSlider, { content: Math.floor(icSlider.value * 100) + '%', trigger: 'manual', arrow: false, animation: 'shift-away' });
        icSlider.addEventListener('input', () => { icTip.setContent(Math.floor(icSlider.value * 100) + '%'); icTip.show(); element("#type-icons").click(); });
        icSlider.addEventListener('blur', () => icTip.hide());
      }

      element("#type-wide-alert").style.display = "none";
      element("#option-tooltip").style.display = "none";
      element("#option-buttonstyle").style.display = "none";
      element("#option-customlogo").style.display = "none";

      function setWideState() {
        element("#type-wide-alert").style.display = "block";
        element("#option-tooltip").style.display = "none";
        element("#option-buttonstyle").style.display = "block";
        element("#option-customlogo").style.display = "block";
        element("#icon-modal-opacity").style.opacity = 0.4;
      }
      function setIconState() {
        element("#type-wide-alert").style.display = "none";
        element("#option-tooltip").style.display = "block";
        element("#option-buttonstyle").style.display = "none";
        element("#option-customlogo").style.display = "none";
        element("#icon-modal-opacity").style.opacity = 1;
      }

      element("#type-wide").addEventListener("click", () => { setWideState(); document.getElementById("tooltip-off").click(); });
      element("#type-icons").addEventListener("click", setIconState);

      if (element("#type-wide").checked) setWideState(); else setIconState();
    });
  </script>
</body>
</html>
