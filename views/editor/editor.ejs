<!DOCTYPE html>
<html lang="en" style="background-color: #070709">
<head>
  <meta charset="utf-8">
  <title>HelzerX 3D Theme Designer</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/x-icon" href="/extensions/nebula/editor/assets/favicon.ico">
  <link rel="stylesheet" href="./assets/base.css">
  <link rel="stylesheet" href="./assets/css/modes/tinypreview.css">
  <link rel="stylesheet" href="./assets/css/helzerx-designer.css">
  <script src="./assets/js/navigation.js"></script>
  <script src="./assets/js/editor.js"></script>
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>
  <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/animations/shift-away.css">
  <style>
    .match-dashboard-bg { background-color: <%= dbGet("nebula", "palette_dashboard_7") %> !important; }
    .match-auth-bg { background-color: <%= dbGet("nebula", "palette_auth_1") %> !important; }
    .hx-toggle-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin-top: 8px;
    }
    .hx-toggle-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 14px;
      border-radius: 14px;
      background: linear-gradient(165deg, #171720 0%, #101016 100%);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 5px 0 0 rgba(5, 5, 8, 0.94), inset 0 1px 0 rgba(255, 255, 255, 0.14);
      cursor: pointer;
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .hx-toggle-card:hover {
      transform: translateY(-2px);
      border-color: rgba(245, 176, 65, 0.45);
    }
    .hx-toggle-card.is-active {
      border-color: rgba(245, 176, 65, 0.8);
      background: linear-gradient(165deg, rgba(245, 176, 65, 0.14) 0%, #13131b 100%);
      box-shadow: 0 6px 0 0 rgba(110, 68, 12, 0.55), 0 14px 26px rgba(245, 176, 65, 0.12), inset 0 1px 0 rgba(255, 232, 178, 0.35);
    }
    .hx-toggle-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #f5f5f7;
      font-size: 13px;
      font-weight: 700;
    }
    .hx-toggle-head i {
      color: #f5b041;
      font-size: 16px;
    }
    .hx-toggle-sub {
      color: #8e8e99;
      font-size: 11px;
      line-height: 1.45;
    }
    @media (max-width: 720px) {
      .hx-toggle-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="navigation">
      <button onclick="navigationAction('admin')" to="admin" class="return-button" type="button"><i class="bi bi-arrow-90deg-left"></i></button>
      <div style="height: 80px;"></div>
      <button onclick="navigationAction('general')" to="general" class="navigation-button active" type="button"><i class="bi bi-sliders2"></i></button>
      <button onclick="navigationAction('palette')" to="palette" class="navigation-button" type="button"><i class="bi bi-palette2"></i></button>
      <button onclick="navigationAction('sidebar')" to="sidebar" class="navigation-button" type="button"><i class="bi bi-layout-sidebar-inset"></i></button>
      <button onclick="navigationAction('dashboard')" to="dashboard" class="navigation-button" type="button"><i class="bi bi-grid-1x2"></i></button>
      <button onclick="navigationAction('authentication')" to="authentication" class="navigation-button" type="button"><i class="bi bi-box-arrow-in-right"></i></button>
      <button onclick="navigationAction('more')" to="more" class="navigation-button" type="button"><i class="bi bi-nut"></i></button>
      <div class="save-padding"></div>
      <button onclick="saveAction()" class="save-button" type="button"><i class="bi bi-floppy-fill"></i></button>
    </div>

    <div class="editor fade">
      <%- include('../partials/designer-toolbar') %>
      <form action="/admin/extensions/nebula" method="POST" id="editor-form" autocomplete="off">
        <div class="editor-container">
          <h2 class="editor-title">General</h2>
          <p class="editor-description">Configure core HelzerX 3D surface styles, website links, and panel announcements.</p>

          <!-- HelzerX 3D Styles -->
          <div class="option">
            <p class="option-title">HelzerX 3D Surface Engine</p>
            <input type="hidden" name="hx_3d_depth" id="hx_3d_depth_val" value="<%= dbGet('nebula', 'hx_3d_depth') %>">
            <input type="hidden" name="hx_spotlight" id="hx_spotlight_val" value="<%= dbGet('nebula', 'hx_spotlight') %>">
            <input type="hidden" name="hx_bevel_buttons" id="hx_bevel_buttons_val" value="<%= dbGet('nebula', 'hx_bevel_buttons') %>">

            <div class="hx-toggle-grid">
              <div class="hx-toggle-card <%= dbGet('nebula', 'hx_3d_depth') === '1' ? 'is-active' : '' %>" data-hx-toggle="hx_3d_depth_val" onclick="toggleHxFeature(this)">
                <div class="hx-toggle-head">
                  <span>3D Plinth Depth</span>
                  <i class="bi bi-layers-half"></i>
                </div>
                <span class="hx-toggle-sub">Extruded obsidian bevel bases, top specular rims, and perspective hover elevation.</span>
              </div>

              <div class="hx-toggle-card <%= dbGet('nebula', 'hx_spotlight') === '1' ? 'is-active' : '' %>" data-hx-toggle="hx_spotlight_val" onclick="toggleHxFeature(this)">
                <div class="hx-toggle-head">
                  <span>Cursor Spotlight</span>
                  <i class="bi bi-brightness-high"></i>
                </div>
                <span class="hx-toggle-sub">Pointer-tracked warm gold radial illumination across server and console surfaces.</span>
              </div>

              <div class="hx-toggle-card <%= dbGet('nebula', 'hx_bevel_buttons') === '1' ? 'is-active' : '' %>" data-hx-toggle="hx_bevel_buttons_val" onclick="toggleHxFeature(this)">
                <div class="hx-toggle-head">
                  <span>3D Bevel Buttons</span>
                  <i class="bi bi-box"></i>
                </div>
                <span class="hx-toggle-sub">Tactile extruded power and action buttons with press-down depression feedback.</span>
              </div>
            </div>
            <p class="option-footer">Click any surface module to enable or disable its 3D rendering layer.</p>
          </div>

          <!-- Website links -->
          <div class="option">
            <button class="modal-open" onclick="modal('#weblinks-modal')" type="button" style="float: left"><i class="bi bi-plus-lg"></i></button>
            <p class="option-title with-button">Website links</p>
            <input type="radio" id="websitelinks-on" name="website_links" value="1" class="hidden" <%= dbGet("nebula", "website_links") == "1" ? "checked" : "" %>>
            <label for="websitelinks-on" class="option-radio" onclick="event.preventDefault();modal('#weblinks-modal');">
              <img src="./assets/images/general/websitelinks/on.png" loading="lazy" class="aspect-16:9"/>
            </label>
            <input type="radio" id="websitelinks-off" name="website_links" value="0" class="hidden" <%= dbGet("nebula", "website_links") == "0" ? "checked" : "" %>>
            <label for="websitelinks-off" class="option-radio" onclick="clearWeblinks()">
              <img src="./assets/images/general/websitelinks/off.png" loading="lazy" class="aspect-16:9"/>
            </label>
            <p class="option-footer">Link buttons to external pages on your Pterodactyl panel.</p>
          </div>

          <!-- Alert -->
          <div class="option">
            <button class="modal-open" onclick="modal('#alert-modal')" type="button" style="float: left"><i class="bi bi-plus-lg"></i></button>
            <p class="option-title with-button">Alert</p>
            <input type="radio" id="alert-on" name="alert" value="1" class="hidden" <%= dbGet("nebula", "alert") == "1" ? "checked" : "" %>>
            <label for="alert-on" class="option-radio" onclick="event.preventDefault();modal('#alert-modal');">
              <img src="./assets/images/general/alert/on.png" loading="lazy" class="aspect-16:9"/>
            </label>
            <input type="radio" id="alert-off" name="alert" value="0" class="hidden" <%= dbGet("nebula", "alert") == "0" ? "checked" : "" %>>
            <label for="alert-off" class="option-radio">
              <img src="./assets/images/general/alert/off.png" loading="lazy" class="aspect-16:9"/>
            </label>
            <p class="option-footer">Display a custom, configurable alert/announcement on your dashboard.</p>
          </div>
        </div>

        <!-- Weblinks modal -->
        <div class="editor-modal" id="weblinks-modal">
          <button class="modal-close" onclick="closeModal('#weblinks-modal')" type="button" style="float: left"><i class="bi bi-chevron-left"></i></button>
          <h2 class="editor-title with-button">Website links</h2>
          <p class="editor-description">Link buttons to external pages on both your authentication page and Pterodactyl panel.</p>

          <div class="option">
            <p class="option-title">Websites</p>
            <div class="option-container with-margin">
              <span class="option-icon"><i class="bi bi-life-preserver"></i></span>
              <input type="text" id="weblink-support" name="weblink_support" class="option-input with-icon" placeholder="https://helzerx.net/support" value="<%= dbGet("nebula", "weblink_support") %>">
              <script>tippy('.option-container:has(.option-icon + #weblink-support)', { content: "Support Page", arrow: false, animation: 'shift-away' });</script>
            </div>
            <div class="option-container with-margin">
              <span class="option-icon"><i class="bi bi-cash-coin"></i></span>
              <input type="text" id="weblink-billing" name="weblink_billing" class="option-input with-icon" placeholder="https://helzerx.net/billing" value="<%= dbGet("nebula", "weblink_billing") %>">
              <script>tippy('.option-container:has(.option-icon + #weblink-billing)', { content: "Billing Panel", arrow: false, animation: 'shift-away' });</script>
            </div>
            <div class="option-container with-margin">
              <span class="option-icon"><i class="bi bi-bar-chart-fill"></i></span>
              <input type="text" id="weblink-status" name="weblink_status" class="option-input with-icon" placeholder="https://status.helzerx.net" value="<%= dbGet("nebula", "weblink_status") %>">
              <script>tippy('.option-container:has(.option-icon + #weblink-status)', { content: "Status Page", arrow: false, animation: 'shift-away' });</script>
            </div>
            <p class="option-footer">Links to websites related to your Pterodactyl panel.</p>
          </div>

          <div class="option">
            <p class="option-title">Social links</p>
            <div class="option-container with-margin">
              <span class="option-icon"><i class="bi bi-discord"></i></span>
              <input type="text" id="weblink-social-discord" name="weblink_social_discord" class="option-input with-icon" placeholder="helzerx" value="<%= dbGet("nebula", "weblink_social_discord") %>">
              <script>tippy('.option-container:has(.option-icon + #weblink-social-discord)', { content: "Discord Guild", arrow: false, animation: 'shift-away' });</script>
            </div>
            <div class="option-container with-margin">
              <span class="option-icon"><i class="bi bi-github"></i></span>
              <input type="text" id="weblink-social-github" name="weblink_social_github" class="option-input with-icon" placeholder="advenslk" value="<%= dbGet("nebula", "weblink_social_github") %>">
              <script>tippy('.option-container:has(.option-icon + #weblink-social-github)', { content: "GitHub Organization", arrow: false, animation: 'shift-away' });</script>
            </div>
            <p class="option-footer">Invite codes or handles to community platforms.</p>
          </div>

          <div class="option">
            <p class="option-title">Alignment</p>
            <input type="radio" id="linkalign-left" name="website_links_align" value="0" class="hidden" <%= dbGet("nebula", "website_links_align") == "0" ? "checked" : "" %>>
            <label for="linkalign-left" class="option-radio sm aspect-square">
              <img src="./assets/images/general/linkalign/left.png"/>
            </label>
            <input type="radio" id="linkalign-right" name="website_links_align" value="1" class="hidden" <%= dbGet("nebula", "website_links_align") == "1" ? "checked" : "" %>>
            <label for="linkalign-right" class="option-radio sm aspect-square">
              <img src="./assets/images/general/linkalign/right.png"/>
            </label>
            <p class="option-footer">Choose where to align the website links.</p>
          </div>
        </div>

        <!-- Alert modal -->
        <div class="editor-modal" id="alert-modal">
          <button class="modal-close" onclick="closeModal('#alert-modal')" type="button" style="float: left"><i class="bi bi-chevron-left"></i></button>
          <h2 class="editor-title with-button">Alert</h2>
          <p class="editor-description">Display a custom, configurable announcement banner on your dashboard.</p>

          <div class="option">
            <p class="option-title">Content</p>
            <textarea id="alertcontent" name="alert_text" class="option-textarea" rows="4" placeholder="Write an announcement for users..."><%= dbGet("nebula", "alert_text") %></textarea>
            <p class="option-footer"><a href="https://daringfireball.net/projects/markdown/" target="_blank">Markdown</a> syntax is supported.</p>
          </div>

          <div class="option">
            <p class="option-title">Icon</p>
            <input type="radio" id="alerticon-disabled" name="alert_icon" value="megaphone-fill" class="hidden" <%= dbGet("nebula", "alert_icon") == "megaphone-fill" ? "checked" : "" %>/>
            <input type="radio" id="alerticon-megaphone" name="alert_icon" value="megaphone-fill" class="hidden" <%= dbGet("nebula", "alert_icon") == "megaphone-fill" ? "checked" : "" %>/>
            <label for="alerticon-megaphone" class="option-radio sm aspect-square" onclick="alertDepend(event)"><img src="./assets/images/general/alerticon/megaphone.png"/></label>
            <input type="radio" id="alerticon-warning" name="alert_icon" value="exclamation-triangle-fill" class="hidden" <%= dbGet("nebula", "alert_icon") == "exclamation-triangle-fill" ? "checked" : "" %>/>
            <label for="alerticon-warning" class="option-radio sm aspect-square" onclick="alertDepend(event)"><img src="./assets/images/general/alerticon/warning.png"/></label>
            <input type="radio" id="alerticon-success" name="alert_icon" value="check-circle-fill" class="hidden" <%= dbGet("nebula", "alert_icon") == "check-circle-fill" ? "checked" : "" %>/>
            <label for="alerticon-success" class="option-radio sm aspect-square" onclick="alertDepend(event)"><img src="./assets/images/general/alerticon/success.png"/></label>
            <input type="radio" id="alerticon-database" name="alert_icon" value="database-fill" class="hidden" <%= dbGet("nebula", "alert_icon") == "database-fill" ? "checked" : "" %>/>
            <label for="alerticon-database" class="option-radio sm aspect-square" onclick="alertDepend(event)"><img src="./assets/images/general/alerticon/database.png"/></label>
            <input type="radio" id="alerticon-message" name="alert_icon" value="chat-square-text-fill" class="hidden" <%= dbGet("nebula", "alert_icon") == "chat-square-text-fill" ? "checked" : "" %>/>
            <label for="alerticon-message" class="option-radio sm aspect-square" onclick="alertDepend(event)"><img src="./assets/images/general/alerticon/message.png"/></label>
            <input type="radio" id="alerticon-gear" name="alert_icon" value="gear-fill" class="hidden" <%= dbGet("nebula", "alert_icon") == "gear-fill" ? "checked" : "" %>/>
            <label for="alerticon-gear" class="option-radio sm aspect-square" onclick="alertDepend(event)"><img src="./assets/images/general/alerticon/gear.png"/></label>
            <input type="radio" id="alerticon-rocket" name="alert_icon" value="rocket-takeoff-fill" class="hidden" <%= dbGet("nebula", "alert_icon") == "rocket-takeoff-fill" ? "checked" : "" %>/>
            <label for="alerticon-rocket" class="option-radio sm aspect-square" onclick="alertDepend(event)"><img src="./assets/images/general/alerticon/rocket.png"/></label>
            <input type="radio" id="alerticon-reception" name="alert_icon" value="reception-4" class="hidden" <%= dbGet("nebula", "alert_icon") == "reception-4" ? "checked" : "" %>/>
            <label for="alerticon-reception" class="option-radio sm aspect-square" onclick="alertDepend(event)"><img src="./assets/images/general/alerticon/reception.png"/></label>
            <p class="option-footer">Pick an icon for this alert.</p>
          </div>

          <div class="option">
            <p class="option-title">Position</p>
            <input type="radio" id="alertposition-disabled" name="alert_position" value="sticky" class="hidden"/>
            <input type="radio" id="alertposition-sticky" name="alert_position" value="sticky" class="hidden" <%= dbGet("nebula", "alert_position") == "sticky" ? "checked" : "" %>>
            <label for="alertposition-sticky" class="option-radio" onclick="alertDepend(event)"><img src="./assets/images/general/alertposition/sticky.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="alertposition-static" name="alert_position" value="static" class="hidden" <%= dbGet("nebula", "alert_position") == "static" ? "checked" : "" %>>
            <label for="alertposition-static" class="option-radio" onclick="alertDepend(event)"><img src="./assets/images/general/alertposition/static.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Keep the alert floating in viewport or pinned to top.</p>
          </div>

          <div class="option">
            <p class="option-title">Dismissable</p>
            <input type="radio" id="alertdismiss-disabled" name="alert_dismiss" value="0" class="hidden"/>
            <input type="radio" id="alertdismiss-on" name="alert_dismiss" value="1" class="hidden" <%= dbGet("nebula", "alert_dismiss") == "1" ? "checked" : "" %>>
            <label for="alertdismiss-on" class="option-radio" onclick="alertDepend(event)"><img src="./assets/images/general/alertdismiss/on.png" loading="lazy" class="aspect-16:9"/></label>
            <input type="radio" id="alertdismiss-off" name="alert_dismiss" value="0" class="hidden" <%= dbGet("nebula", "alert_dismiss") == "0" ? "checked" : "" %>>
            <label for="alertdismiss-off" class="option-radio" onclick="alertDepend(event)"><img src="./assets/images/general/alertdismiss/off.png" loading="lazy" class="aspect-16:9"/></label>
            <p class="option-footer">Allow or disallow users to dismiss the alert.</p>
          </div>
        </div>

        <div id="editor-submit">
          <input type="hidden" name="_endpoint" value="/extensions/nebula/editor/editor.php">
          <input type="hidden" name="_method" value="PATCH">
          <button type="submit" class="hidden" id="submit"></button>
        </div>
      </form>
    </div>

    <div class="preview fade">
      <iframe
        title="Preview"
        class="preview-frame mobile-xs"
        src="/extensions/nebula/preview/placeholder.php"
        style="--scale: 1; --size: 100%;"
        loading="lazy">
      </iframe>
    </div>

    <%- include('../partials/unsaved-modal') %>
  </div>

  <script>
    function toggleHxFeature(card) {
      const inputId = card.getAttribute('data-hx-toggle');
      const input = document.getElementById(inputId);
      const next = input.value === '1' ? '0' : '1';
      input.value = next;
      card.classList.toggle('is-active', next === '1');
      if (typeof showSaveButton === 'function') showSaveButton();
    }

    document.addEventListener("DOMContentLoaded", function () {
      element("#editor-form").addEventListener("change", function () {
        if (
          element("#weblink-support").value == "" &&
          element("#weblink-billing").value == "" &&
          element("#weblink-status").value == "" &&
          element("#weblink-social-discord").value == "" &&
          element("#weblink-social-github").value == ""
        ) {
          element("#websitelinks-off").checked = true;
        } else {
          element("#websitelinks-on").checked = true;
        }
      });

      if (
        element("#weblink-support").value == "" &&
        element("#weblink-billing").value == "" &&
        element("#weblink-status").value == "" &&
        element("#weblink-social-discord").value == "" &&
        element("#weblink-social-github").value == ""
      ) {
        element("#websitelinks-off").checked = true;
      }

      element("#alert-off").addEventListener("click", function () {
        element("#alertcontent").value = null;
        element("#alerticon-disabled").click();
        element("#alertposition-disabled").click();
        element("#alertdismiss-disabled").click();
      });
      element("#alertcontent").addEventListener("change", function () {
        if (element("#alertcontent").value == "") {
          element("#alerticon-disabled").checked = true;
          element("#alertposition-disabled").checked = true;
          element("#alertdismiss-disabled").checked = true;
          element("#alert-off").checked = true;
        } else {
          element("#alert-on").click();
          if (element("#alerticon-disabled").checked) element("#alerticon-megaphone").checked = true;
          if (element("#alertposition-disabled").checked) element("#alertposition-sticky").checked = true;
          if (element("#alertdismiss-disabled").checked) element("#alertdismiss-off").checked = true;
        }
      });

      if (element("#alertcontent").value == "") {
        element("#alert-off").checked = true;
        element("#alerticon-disabled").checked = true;
        element("#alertposition-disabled").checked = true;
        element("#alertdismiss-disabled").checked = true;
      }
    });

    function clearWeblinks() {
      element("#weblink-support").value = "";
      element("#weblink-billing").value = "";
      element("#weblink-status").value = "";
      element("#weblink-social-discord").value = "";
      element("#weblink-social-github").value = "";
    }

    function alertDepend(event) {
      if (element("#alertcontent").value == '') {
        event.preventDefault();
        element("#alertcontent").focus();
      }
    }
  </script>
</body>
</html>
